# Supabase — copy this file to ".env" and fill in your project's values.
# Find them in the Supabase dashboard: Project Settings → API.
# Only the public "anon" key goes here. NEVER put the service_role key in a
# VITE_ variable — anything prefixed VITE_ is shipped to the browser.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
